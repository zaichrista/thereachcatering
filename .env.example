PORT=4000
DB_PATH=./data/reach.db
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins of the website allowed to call this API
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Set to 1 when running behind a proxy/PaaS (Render, Fly, Nginx...)
# TRUST_PROXY=1

# Used by `npm run seed` to create the admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Email (optional; without SMTP_HOST emails are skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Reach Catering Co. <no-reply@yourdomain.com>"
NOTIFY_EMAIL=owner@yourdomain.com
